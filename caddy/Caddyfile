# D3 Edge enforcement via Caddy's built-in forward_auth — config only, no
# custom build. Copy the two pieces below into your Caddyfile and set
# D3_EDGE_ADAPTER_KEY in Caddy's environment. See README.md in this directory.

# ---- 1. The decision gateway (one per Caddyfile) ---------------------------
# forward_auth cannot fail open on its own: any upstream error is returned to
# the visitor as-is. This local hop converts "the decision endpoint is down or
# slow" into a 200 fail-open before forward_auth can see an error, so an
# outage on D3's side never takes your site down.
# `http://:8113` + bind, NOT `http://127.0.0.1:8113`: the subrequest carries
# the visitor's Host, and a hostname-scoped address only matches Host
# 127.0.0.1 — every real request would get Caddy's empty 200 for unmatched
# hosts, which forward_auth reads as a pass without ever calling D3.
http://:8113 {
	bind 127.0.0.1
	reverse_proxy https://edge-api.d3.com {
		header_up Host edge-api.d3.com
		transport http {
			# The whole decision budget: a hung endpoint degrades like a down one.
			# 500ms covers a cold isolate; a canceled call is never logged.
			response_header_timeout 500ms
		}
	}
	handle_errors {
		header x-d3-edge fail-open
		respond 200
	}
}

# ---- 2. The check (inside each site you want covered) -----------------------
example.com {
	forward_auth 127.0.0.1:8113 {
		uri /v1/forward-auth
		# Your org's adapter key (dashboard → Keys), from Caddy's environment.
		header_up x-d3-adapter-key {env.D3_EDGE_ADAPTER_KEY}
		# The pinned client IP — the endpoint never trusts X-Forwarded-For.
		# x-d3-real-ip, not X-Real-IP: Cloudflare-fronted endpoints rewrite
		# X-Real-IP to the connecting IP (your server), never the visitor.
		header_up x-d3-real-ip {client_ip}
		# Never ours to see.
		header_up -Cookie
		header_up -Authorization
		header_up -Proxy-Authorization
		# A visitor must not pin its own tuple, key, or digest.
		header_up -x-d3-method
		header_up -x-d3-host
		header_up -x-d3-uri
		header_up -x-d3-content-digest
	}

	# ...the rest of your site config, e.g.:
	reverse_proxy backend:3000
}

# ---- 3. Ramp-up: sample a fraction of traffic (optional) --------------------
# forward_auth takes a matcher, so gate it to send only some requests to the
# decision endpoint. {http.request.uuid} is a per-request UUIDv4, and lowercase
# hex sorts the same lexicographically as numerically, so comparing it against a
# 4-hex-digit threshold passes a uniform fraction — threshold/65536, with no
# state and no per-request cost beyond the random bytes Caddy already generates.
# An unsampled request skips the call entirely: no decision, nothing logged, no
# x-d3-edge header — it costs what an uninstalled check costs. Default to full
# coverage ("ffff", ~100%, or just drop the matcher as in section 2) and dial
# down to ramp: "8000" = 50%, "1999" ≈ 10% (0x1999 / 0x10000), "028f" ≈ 1%.
sampled.example.com {
	@d3_sampled expression `{http.request.uuid} < "ffff"`
	forward_auth @d3_sampled 127.0.0.1:8113 {
		# ...same block as section 2
		uri /v1/forward-auth
		header_up x-d3-adapter-key {env.D3_EDGE_ADAPTER_KEY}
		header_up x-d3-real-ip {client_ip}
		header_up -Cookie
		header_up -Authorization
		header_up -Proxy-Authorization
		header_up -x-d3-method
		header_up -x-d3-host
		header_up -x-d3-uri
		header_up -x-d3-content-digest
	}

	reverse_proxy backend:3000
}
